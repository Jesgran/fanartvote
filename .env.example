# URL pubblico dell'app (https in produzione). Deve coincidere con il Redirect URI su Discord: BASE_URL/auth/callback
BASE_URL=http://localhost:3000
PORT=3000
# Se sei dietro a un reverse proxy / tunnel (Cloudflare, Render, ...) metti 1
TRUST_PROXY=0

# Discord Developer Portal -> la tua Application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Tab Bot -> Reset Token. Il bot deve essere nel server con permessi "View Channel" + "Read Message History" sul forum
DISCORD_BOT_TOKEN=
# Developer Portal -> General Information -> Public Key (serve per il comando "Aggiungi al voto")
DISCORD_PUBLIC_KEY=

GUILD_ID=
FORUM_CHANNEL_ID=
# Opzionale: solo chi ha questo ruolo può votare
VOTER_ROLE_ID=
# ID Discord degli admin, separati da virgola
ADMIN_IDS=

# Voto massimo (2-10) e frequenza di sync automatico in minuti (0 = solo manuale)
MAX_SCORE=10
SYNC_INTERVAL_MIN=10
